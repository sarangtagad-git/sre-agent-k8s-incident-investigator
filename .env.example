# Copy to .env and fill in. .env is git-ignored.

# Anthropic API key for the agent's reasoning (Claude).
ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model the agent uses (opus-4-8 = best reasoning; sonnet-5 = cheaper).
AGENT_MODEL=claude-opus-4-8
# Reasoning depth / token spend: low | medium | high | xhigh | max
AGENT_EFFORT=high

# Read-only kubeconfig the agent authenticates with (generated by
# infra/rbac/gen-kubeconfig.sh). Keep this SEPARATE from your admin kubeconfig.
AGENT_KUBECONFIG=infra/rbac/sre-agent.kubeconfig

# Prometheus endpoint (via `kubectl -n monitoring port-forward svc/kps-kube-prometheus-stack-prometheus 9090:9090`)
PROMETHEUS_URL=http://localhost:9090

# Safety: hard cap on tool-calling iterations per investigation.
AGENT_MAX_TOOL_ITERATIONS=12
