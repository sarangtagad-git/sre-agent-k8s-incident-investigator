# Copy to .env and fill in. .env is git-ignored.

# Anthropic API key for the agent's reasoning (Claude).
ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model the agent uses (opus-4-8 = best reasoning; sonnet-5 = cheaper).
AGENT_MODEL=claude-opus-4-8
# Reasoning depth / token spend: low | medium | high | xhigh | max
AGENT_EFFORT=high

# Read-only kubeconfig the agent authenticates with (generated by
# infra/rbac/gen-kubeconfig.sh). Keep this SEPARATE from your admin kubeconfig.
AGENT_KUBECONFIG=infra/rbac/sre-agent.kubeconfig

# Prometheus endpoint (via `kubectl -n monitoring port-forward svc/kps-kube-prometheus-stack-prometheus 9090:9090`)
PROMETHEUS_URL=http://localhost:9090

# Safety: hard cap on tool-calling iterations per investigation.
AGENT_MAX_TOOL_ITERATIONS=12

# Optional: gather-phase model swap (experimental). Routes ONLY the tool-calling
# loop through an OpenAI-compatible open-source model; recall/correlate/
# hypothesize/propose always stay on Claude. Leave GATHER_MODEL empty (default)
# to keep gather on Claude too — nothing below changes behavior until it's set.
# GATHER_MODEL=qwen/qwen-2.5-72b-instruct
# GATHER_BASE_URL=https://openrouter.ai/api/v1
# GATHER_API_KEY=
# $ per 1M tokens for GATHER_MODEL — check the provider's current pricing page.
# GATHER_PRICE_IN=0.12
# GATHER_PRICE_OUT=0.39

# Optional: export agent traces (LLM calls + tool calls) to self-hosted LLM-
# observability backends, for debugging/cost/eval visibility beyond the console.
# Both are free, OTLP/HTTP sinks fed from the same spans — set either, both, or
# neither. See docs on running each via docker-compose (Opik: comet-ml/opik repo;
# Langfuse: langfuse/langfuse repo).
# OPIK_URL=http://localhost:5173
# OPIK_PROJECT_NAME=sre-agent
# LANGFUSE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
